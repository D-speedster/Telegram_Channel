# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Admin Configuration (comma-separated user IDs)
ADMIN_USER_ID=123456789,987654321

# Channel Configuration
# Film Channel
FILM_CHANNEL_ID=@film_channel
# Italia Channel
ITALIA_CHANNEL_ID=@italia_channel

# Liara AI Configuration
# Get your API key from: https://console.liara.ir/ai
LIARA_API_KEY=lrn_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Your base URL will be like: https://ai.liara.ir/api/v1/682833f68c7347b1c1612d00
LIARA_BASE_URL=https://ai.liara.ir/api/v1/your_service_id_here

# Logging
LOG_LEVEL=INFO
